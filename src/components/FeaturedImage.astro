---
import { Image } from 'astro:assets';

/**
 * Renders a post's `featured_image`, which may be either:
 *   - a local upload, already resolved to ImageMetadata by the content schema, or
 *   - a remote URL string (a pasted stock-photo link).
 *
 * Remote images need `inferSize` so Astro fetches them at build time to learn
 * their dimensions — without it the build fails with MissingImageDimension,
 * because an image of unknown size cannot reserve layout space and would cause
 * a layout shift. Combined with `image.remotePatterns` in astro.config.mjs they
 * are also resized and re-served from this origin, so readers make no
 * third-party request either way.
 */
interface Props {
  src: ImageMetadata | string;
  alt: string;
  widths: number[];
  sizes: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { src, alt, widths, sizes, loading = 'lazy', fetchpriority } = Astro.props;
---

{
  typeof src === 'string' ? (
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      inferSize
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
    />
  )
}
